# Firebase settings for CueMii.
#
# Copy this file to ".env" and fill in the values from the Firebase console
# (Project settings > General > Your apps > SDK setup and configuration).
#
# ".env" is git-ignored, so real values stay out of the repository. On Netlify,
# set the same names under Site settings > Environment variables instead.
#
# Without these the app still runs — it simply starts with cloud sync
# unavailable, and everything is kept locally.

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=cuemii-database.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=cuemii-database
REACT_APP_FIREBASE_STORAGE_BUCKET=cuemii-database.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=129349819856
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=G-YBZDH11K3T
