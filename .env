REACT_APP_FIREBASE_AUTH_DOMAIN=cuemii-database.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=cuemii-database
REACT_APP_FIREBASE_STORAGE_BUCKET=cuemii-database.firebasestorage.app
